---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
---
<Base lang="en" title={`Page not found – ${SITE.name}`} description="Page not found" noindex>
  <main style="min-height:100vh;display:grid;place-items:center;text-align:center;padding:24px">
    <div>
      <p class="eyebrow">404</p>
      <h1 style="font-size:clamp(32px,6vw,56px);margin-bottom:12px">Page not found</h1>
      <p style="color:var(--muted)">The page you are looking for does not exist.</p>
      <p><a class="btn" href="/">Go home</a></p>
    </div>
  </main>
</Base>
