---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config';
---
<Base lang="en" title={`Admin – ${SITE.name}`} description="Private dashboard" path="admin/" noindex>
  <main class="admin container" id="main">
    <header class="admin-top">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">{SITE.initials}</span><span class="brand-name">Admin</span></a>
      <div class="tools"><button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle dark mode"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button><button class="btn ghost small" id="signout" type="button" hidden>Sign out</button></div>
    </header>

    <section id="no-backend" hidden class="notice">Backend not configured. Set <code>PUBLIC_SUPABASE_URL</code> and <code>PUBLIC_SUPABASE_ANON_KEY</code>, then rebuild.</section>

    <section id="login" class="login-card" hidden>
      <h1>Sign in</h1>
      <form class="form" id="login-form">
        <div class="field"><label for="l-email">Email</label><input id="l-email" type="email" autocomplete="username" required /></div>
        <div class="field"><label for="l-pass">Password</label><input id="l-pass" type="password" autocomplete="current-password" required /></div>
        <button class="btn" type="submit">Sign in</button>
        <p class="status" id="login-status" role="alert"></p>
      </form>
    </section>

    <section id="app" hidden>
      <div class="filters" role="tablist">
        <button class="filter" role="tab" data-tab="messages" aria-pressed="true">Messages <span class="badge" id="unread">0</span></button>
        <button class="filter" role="tab" data-tab="projects" aria-pressed="false">Projects</button>
        <button class="filter" role="tab" data-tab="traffic" aria-pressed="false">Traffic</button>
      </div>

      <div id="tab-messages"><div class="list" id="messages-list"></div></div>

      <div id="tab-projects" hidden>
        <p><button class="btn small" id="new-project" type="button">Add project</button></p>
        <div class="list" id="projects-list"></div>
      </div>

      <div id="tab-traffic" hidden><div class="stats" id="traffic-stats"></div><div class="list" id="traffic-list"></div></div>
    </section>

    <dialog id="project-dialog">
      <form class="form" id="project-form" method="dialog">
        <h2 id="pd-title">Project</h2>
        <div class="field"><label for="p-title">Title</label><input id="p-title" name="title" required maxlength="120" /></div>
        <div class="field"><label for="p-desc">Description</label><textarea id="p-desc" name="description" required maxlength="600" style="min-height:90px"></textarea></div>
        <div class="field"><label for="p-cat">Category</label><select id="p-cat" name="category" class="lang-select"><option value="apps">Apps</option><option value="data">Data</option><option value="education">Education</option></select></div>
        <div class="field"><label for="p-stack">Stack (comma separated)</label><input id="p-stack" name="stack" placeholder="Python, FastAPI" /></div>
        <div class="field"><label for="p-live">Live URL</label><input id="p-live" name="live_url" type="url" placeholder="https://" /></div>
        <div class="field"><label for="p-code">Code URL</label><input id="p-code" name="code_url" type="url" placeholder="https://" /></div>
        <div class="field"><label for="p-status">Status</label><select id="p-status" name="status" class="lang-select"><option value="done">Done</option><option value="in-progress">In progress</option></select></div>
        <div class="field"><label for="p-order">Sort order (lower first)</label><input id="p-order" name="sort_order" type="number" value="0" /></div>
        <label style="display:flex;gap:8px;align-items:center"><input type="checkbox" name="published" checked /> Published</label>
        <p class="status err" id="pd-status" role="alert"></p>
        <div class="cta-row"><button class="btn" type="submit" id="pd-save">Save</button><button class="btn ghost" type="button" id="pd-cancel">Cancel</button></div>
      </form>
    </dialog>
  </main>
  <script>import '../../scripts/admin.ts';</script>
</Base>

<style is:global>
  .admin { padding: 20px 0 80px; }
  .admin-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; }
  .login-card { max-width: 420px; margin: 6vh auto; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; }
  .login-card h1 { margin-bottom: 18px; font-size: 28px; }
  .list { display: grid; gap: 12px; margin-top: 16px; }
  .row { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; display: grid; gap: 6px; }
  .row.unread { border-left: 4px solid var(--accent); }
  .row .head { display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; align-items: baseline; }
  .row .msg { white-space: pre-wrap; word-break: break-word; margin: 0; }
  .row .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  dialog { border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg); color: var(--ink); width: min(560px, 94vw); padding: 24px; max-height: 92vh; overflow: auto; }
  dialog::backdrop { background: rgb(0 0 0 / .55); }
</style>
