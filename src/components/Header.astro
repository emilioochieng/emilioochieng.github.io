---
import { SITE } from '../config';
import { LANGS, LANG_CODES, type Lang } from '../i18n';
import type { Dict } from '../i18n/en';
interface Props { t: Dict; lang: Lang }
const { t, lang } = Astro.props;
const links = [['about', t.nav.about], ['skills', t.nav.skills], ['projects', t.nav.projects], ['writing', t.nav.writing], ['sql', t.nav.sql], ['contact', t.nav.contact]];
---
<a class="skip" href="#main">{t.nav.skip}</a>
<header class="site-header">
  <div class="container">
    <a class="brand" href={`/${lang}/`} aria-label={SITE.name}>
      <span class="brand-mark" aria-hidden="true">{SITE.initials}</span><span class="brand-name">{SITE.name}</span>
    </a>
    <nav class="nav" id="nav" aria-label="Primary">
      {links.map(([id, label]) => <a href={`#${id}`} data-nav={id}>{label}</a>)}
    </nav>
    <div class="tools">
      <label class="sr-only" for="lang-select">{t.nav.language}</label>
      <select class="lang-select" id="lang-select">
        {LANG_CODES.map((l) => <option value={l} selected={l === lang}>{LANGS[l].native}</option>)}
      </select>
      <button class="icon-btn" id="theme-toggle" type="button" aria-label={t.nav.theme}><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
      <button class="icon-btn burger" id="burger" type="button" aria-label={t.nav.menu} aria-expanded="false" aria-controls="nav"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
    </div>
  </div>
</header>
